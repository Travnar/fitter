<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="Bindings_Globals.lua"/>
    <Button name="FitterMountButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/run FitM()")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterHearthstoneButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/use Hearthstone")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterOutfitUpdateButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/run FitU()")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterToyButtonTemplate" inherits="SecureActionButtonTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("LeftButtonDown")
            </OnLoad>
        </Scripts>
    </Button>
</Ui>
