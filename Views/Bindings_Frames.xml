<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="Bindings_Globals.lua"/>
    <Button name="FitterMountButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/run FitM()")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterHearthstoneButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/use item:6948")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterFishingButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                local info = C_Spell.GetSpellInfo(131474) or C_Spell.GetSpellInfo(7620)
                self:SetAttribute("macrotext", "/cast " .. (info and info.name or "Fishing"))
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterSitButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/sit")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterOutfitUpdateButton" inherits="SecureActionButtonTemplate" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self:SetAttribute("type", "macro")
                self:SetAttribute("macrotext", "/run FitU()")
                self:RegisterForClicks("AnyUp", "AnyDown")
            </OnLoad>
        </Scripts>
    </Button>
    <Button name="FitterToyButtonTemplate" inherits="SecureActionButtonTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("LeftButtonDown")
            </OnLoad>
        </Scripts>
    </Button>
</Ui>
